# ===== Django =====
DEBUG=1
SECRET_KEY=django-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ===== База данных =====
# Для локальной разработки без Postgres можно поставить DB_ENGINE=sqlite
DB_ENGINE=postgres
DB_NAME=happiness_receipt
DB_USER=happiness
DB_PASSWORD=happiness
DB_HOST=db
DB_PORT=5432

# ===== Промо-акция «Чек на удачу» =====
# Даты задаются в часовом поясе акции (PROMO_TIMEZONE):
# период = от начала PROMO_START_DATE до конца PROMO_END_DATE включительно.
PROMO_START_DATE=2026-10-01
PROMO_END_DATE=2026-10-31
PROMO_TIMEZONE=Asia/Novosibirsk

# ===== Локализация =====
LANGUAGE_CODE=ru
TIME_ZONE=UTC

# ===== Загрузка фото чека =====
RECEIPT_PHOTO_MAX_MB=10

# ===== Суперпользователь (создаётся entrypoint.sh при старте, если не существует) =====
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin12345
DJANGO_SUPERUSER_EMAIL=admin@example.com